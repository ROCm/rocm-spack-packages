From 81218ebe804e128b2c62ed31cc2754a4a2b962bb Mon Sep 17 00:00:00 2001
From: "Galantsev, Dmitrii" <dmitrii.galantsev@amd.com>
Date: Thu, 5 Mar 2026 13:49:04 -0600
Subject: [PATCH] [ROCM-SMI] Fix DRM include dirs leaking absolute build paths
 to consumers

Make DRM include directories PRIVATE on rocm_smi64 and oam targets,
matching amdsmi's approach. This prevents build-time absolute paths
from leaking into exported CMake targets.

Add pkg_check_modules for libdrm_amdgpu (previously referenced but
never found). Add find_dependency(PkgConfig) + pkg_check_modules in
rocm_smi-config.cmake.in so consumers auto-discover DRM include paths
for the transitive rocm_smi.h -> kfd_ioctl.h -> libdrm/drm.h dependency.

Also fixes pre-existing bug: {OAM_NAME} -> ${OAM_NAME} in oam
INSTALL_INTERFACE.

Fixes: ROCm/TheRock#3702
Relates: ROCm/rocm-systems#3776, ROCm/rocm-systems#209

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
---
 projects/rocm-smi-lib/CMakeLists.txt           | 14 ++++----------
 projects/rocm-smi-lib/oam/CMakeLists.txt       | 10 +++++-----
 projects/rocm-smi-lib/rocm_smi-config.cmake.in | 14 +++++++++++++-
 projects/rocm-smi-lib/rocm_smi/CMakeLists.txt  |  8 ++++----
 4 files changed, 26 insertions(+), 20 deletions(-)

diff --git a/projects/rocm-smi-lib/CMakeLists.txt b/projects/rocm-smi-lib/CMakeLists.txt
index 96103e7e42d..1c39de984ab 100644
--- a/projects/rocm-smi-lib/CMakeLists.txt
+++ b/projects/rocm-smi-lib/CMakeLists.txt
@@ -15,7 +15,7 @@ list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/cmake_modules")
 ## Include common cmake modules
 include(utils)
 
-find_package(PkgConfig)
+find_package(PkgConfig REQUIRED)
 
 # Default libdir to "lib", this skips GNUInstallDirs from trying to take a guess if it's unset:
 set(CMAKE_INSTALL_LIBDIR "lib" CACHE STRING "Library install directory")
@@ -51,15 +51,9 @@ set(BUILD_DEBIAN_PKGING_FLAG
     "Internal Status Flag to indicate Debian Packaging Build"
 )
 
-# sets DRM_INCLUDE_DIRS
-pkg_check_modules(DRM libdrm)
-if(NOT DRM_FOUND)
-  if(EXISTS "/etc/debian_version")
-    message(FATAL_ERROR "libdrm not found. Please install libdrm, libdrm-dev or libdrm-amdgpu-dev package.")
-  else()
-    message(FATAL_ERROR "libdrm not found. Please install libdrm, libdrm-devel or libdrm-amdgpu-devel package.")
-  endif()
-endif()
+# sets DRM_INCLUDE_DIRS and DRM_AMDGPU_INCLUDE_DIRS
+pkg_check_modules(DRM REQUIRED libdrm)
+pkg_check_modules(DRM_AMDGPU REQUIRED libdrm_amdgpu)
 
 ## Setup the package version based on git tags.
 set(PKG_VERSION_GIT_TAG_PREFIX "rsmi_pkg_ver")
diff --git a/projects/rocm-smi-lib/oam/CMakeLists.txt b/projects/rocm-smi-lib/oam/CMakeLists.txt
index 7aa1b5ff753..ff40c45b0c7 100644
--- a/projects/rocm-smi-lib/oam/CMakeLists.txt
+++ b/projects/rocm-smi-lib/oam/CMakeLists.txt
@@ -74,7 +74,10 @@ add_library(${OAM_TARGET} ${CMN_SRC_LIST} ${OAM_SRC_LIST}
                                               ${CMN_INC_LIST} ${OAM_INC_LIST})
 target_link_libraries(${OAM_TARGET} PRIVATE pthread rt dl)
 target_include_directories(${OAM_TARGET} PRIVATE
-   ${CMAKE_CURRENT_SOURCE_DIR}/include ${COMMON_PROJ_ROOT}/common/shared_mutex)
+   ${CMAKE_CURRENT_SOURCE_DIR}/include
+   ${COMMON_PROJ_ROOT}/common/shared_mutex
+   ${DRM_INCLUDE_DIRS}
+   ${DRM_AMDGPU_INCLUDE_DIRS})
 
 ## Set the VERSION and SOVERSION values
 set_property(TARGET ${OAM_TARGET} PROPERTY
@@ -91,13 +94,10 @@ if ("${CMAKE_BUILD_TYPE}" STREQUAL Release)
     endif()
 endif ()
 
-# use the target_include_directories() command to specify the include directories for the target
 target_include_directories(${OAM_TARGET}
                            PUBLIC
-                           "$<BUILD_INTERFACE:${DRM_INCLUDE_DIRS}>"
-                           "$<BUILD_INTERFACE:${AMDGPU_DRM_INCLUDE_DIRS}>"
                            "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>"
-                           "$<INSTALL_INTERFACE:{OAM_NAME}/include>")
+                           "$<INSTALL_INTERFACE:${OAM_NAME}/include>")
 
 ## Add the install directives for the runtime library.
 install(TARGETS ${OAM_TARGET}
diff --git a/projects/rocm-smi-lib/rocm_smi-config.cmake.in b/projects/rocm-smi-lib/rocm_smi-config.cmake.in
index 83a8871af4c..4d0c008bbfb 100644
--- a/projects/rocm-smi-lib/rocm_smi-config.cmake.in
+++ b/projects/rocm-smi-lib/rocm_smi-config.cmake.in
@@ -14,9 +14,21 @@ set_and_check( rocm_smi_LIB_DIR "@PACKAGE_LIB_INSTALL_DIR@" )
 set_and_check( ROCM_SMI_LIB_DIR "@PACKAGE_LIB_INSTALL_DIR@" )
 set_and_check( ROCM_SMI_LIB_DIRS "@PACKAGE_LIB_INSTALL_DIR@" )
 
+# rocm_smi public headers transitively include libdrm/drm.h (via kfd_ioctl.h),
+# so consumers need libdrm include paths. Find them via pkg-config.
+include(CMakeFindDependencyMacro)
+find_dependency(PkgConfig)
+pkg_check_modules(_ROCM_SMI_DRM REQUIRED libdrm)
+
 # Our library dependencies (contains definitions for IMPORTED targets)
-if(NOT TARGET rocm_smi AND NOT rocm_smi_BINARY_DIR)
+if(NOT TARGET rocm_smi64 AND NOT rocm_smi_BINARY_DIR)
     include("${ROCM_SMI_CMAKE_DIR}/rocm_smiTargets.cmake")
+    # Append libdrm include directories to the imported target so that
+    # consumers can compile against rocm_smi.h -> kfd_ioctl.h -> libdrm/drm.h
+    if(TARGET rocm_smi64)
+        set_property(TARGET rocm_smi64 APPEND PROPERTY
+            INTERFACE_INCLUDE_DIRECTORIES "${_ROCM_SMI_DRM_INCLUDE_DIRS}")
+    endif()
 endif()
 
 # These are IMPORTED targets created by RocmSmiTargets.cmake
diff --git a/projects/rocm-smi-lib/rocm_smi/CMakeLists.txt b/projects/rocm-smi-lib/rocm_smi/CMakeLists.txt
index 45b09a18b9a..18f7b482661 100644
--- a/projects/rocm-smi-lib/rocm_smi/CMakeLists.txt
+++ b/projects/rocm-smi-lib/rocm_smi/CMakeLists.txt
@@ -83,13 +83,13 @@ add_library(${ROCM_SMI_TARGET}  ${CMN_SRC_LIST} ${SMI_SRC_LIST}
                                               ${CMN_INC_LIST} ${SMI_INC_LIST})
 target_link_libraries(${ROCM_SMI_TARGET} PRIVATE pthread rt dl)
 target_include_directories(${ROCM_SMI_TARGET} PRIVATE
-          ${CMAKE_CURRENT_SOURCE_DIR} ${COMMON_PROJ_ROOT}/common/shared_mutex)
+          ${CMAKE_CURRENT_SOURCE_DIR}
+          ${COMMON_PROJ_ROOT}/common/shared_mutex
+          ${DRM_INCLUDE_DIRS}
+          ${DRM_AMDGPU_INCLUDE_DIRS})
 
-# use the target_include_directories() command to specify the include directories for the target
 target_include_directories(${ROCM_SMI_TARGET}
                            PUBLIC
-                           "$<BUILD_INTERFACE:${DRM_INCLUDE_DIRS}>"
-                           "$<BUILD_INTERFACE:${AMDGPU_DRM_INCLUDE_DIRS}>"
                            "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>"
                            "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>"
 )
